<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Alternity156</Author>
    <Name>English Target Cast</Name>
    <Punchline>Shows your target's cast bar in English, whatever your client language.</Punchline>
    <Description>Replaces the action name on the target and focus target cast bars with its English name, using the game's own English data. Useful when playing on a Japanese, German or French client.</Description>
    <RepoUrl>https://github.com/Alternity156/English-Target-Cast</RepoUrl>
    <Tags>ui;castbar;translation;english</Tags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copies the plugin icon next to the DLL, where Dalamud looks for it when loading a dev plugin. -->
    <Content Include="..\images\icon.png" Link="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
